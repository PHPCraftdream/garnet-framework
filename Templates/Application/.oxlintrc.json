{
  "$schema": "./vendor/phpcraftdream/garnet-framework/FrontBuilder/node_modules/oxlint/configuration_schema.json",
  "extends": ["./vendor/phpcraftdream/garnet-framework/FrontBuilder/node_modules/@react-carburetor/core/dist/lint/recommended.oxlintrc.json", "./vendor/phpcraftdream/garnet-framework/FrontBuilder/node_modules/@react-carburetor/core/dist/lint/house-style.oxlintrc.json"],
  "jsPlugins": ["./vendor/phpcraftdream/garnet-framework/FrontBuilder/oxlint-plugins/garnet-tsx-rules.js", "./vendor/phpcraftdream/garnet-framework/FrontBuilder/node_modules/@react-carburetor/core/dist/lint/index.mjs"],
  "plugins": ["react", "typescript", "unicorn", "import"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/*.gen.js",
    "**/*.gen.css",
    "vendor/**"
  ],
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-underscore-dangle": "off",

    "react-hooks/exhaustive-deps": "warn",

    "unicorn/no-thenable": "off",

    "unicorn/no-empty-file": "warn",

    "no-async-promise-executor": "warn",
    "no-shadow-restricted-names": "warn",
    "no-unused-expressions": "warn",
    "no-extra-boolean-cast": "warn",
    "no-cond-assign": "warn",
    "typescript/no-this-alias": "warn",

    "garnet-tsx/one-export-per-component": "warn",
    "garnet-tsx/max-component-lines": "warn",
    "garnet-tsx/max-component-nesting": "warn",

    "carburetor/no-react-hooks-in-components": "error",
    "carburetor/no-capturing-hook-selector": "error",
    "carburetor/no-closure-in-update": "error",
    "carburetor/require-hoisted-constant": "error",
    "carburetor/no-direct-data-write": "error",
    "carburetor/no-escaping-tracked-data": "error",
    "carburetor/no-function-in-render": "error",
    "carburetor/no-handler-created-in-render": "error",
    "carburetor/max-render-depth": "error",
    "carburetor/max-render-lines": "error",
    "carburetor/no-unrecognized-base": "error",
    "carburetor/no-store-read-in-effect-deps": "error",
    "carburetor/prefer-store-effect": "error",
    "carburetor/no-memo-over-store-read": "error",
    "carburetor/no-untrackable-draft-mutation": "error",
    "carburetor/no-untrackable-store-data": "error",
    "carburetor/require-effect-deps": "error",
    "carburetor/require-method-for-closure": "error",
    "carburetor/require-module-function": "error",
    "carburetor/require-subscription-disposal": "error",
    "carburetor/max-line-length": "error",
    "carburetor/no-blank-line-after-tsdoc": "error",
    "carburetor/no-parent-import": ["error", { "roots": [{ "path": "Common", "prefix": "@common/" }, { "path": "Front", "prefix": "@framework/" }] }],
    "carburetor/prefer-readonly-array-param": "error",
    "carburetor/require-tsdoc": "error",
    "carburetor/tsdoc-blank-line-before-tags": "error",
    "carburetor/one-export-per-file": "error",
    "carburetor/no-module-level-store": "error"
  }
}
