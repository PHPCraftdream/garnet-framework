# Garnet App Environment Configuration
# Copy this file to .env and fill in the values for your environment.
#
# This is the ONLY thing the framework reads from .env at boot — it
# resolves which app under Apps/<Name> (or the app-mode repo root) to
# load. Everything else (DB, SMTP, base_url, …) lives in
# WorkDir/Config*/*.ini — see docs/quickstart.md and docs/cli.md.

APP_NAME=Application
