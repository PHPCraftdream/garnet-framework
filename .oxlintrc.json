{
  "$schema": "./FrontBuilder/node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["./FrontBuilder/oxlint-plugins/garnet-tsx-rules.js"],
  "plugins": ["react", "typescript", "unicorn", "import"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/*.gen.js",
    "**/*.gen.css",
    "**/I18nGen/**",
    "vendor/**"
  ],
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-underscore-dangle": "off",

    "react-hooks/exhaustive-deps": "warn",

    "unicorn/no-thenable": "off",

    "no-async-promise-executor": "warn",
    "no-shadow-restricted-names": "warn",
    "no-unused-expressions": "warn",
    "no-extra-boolean-cast": "warn",
    "no-cond-assign": "warn",
    "typescript/no-this-alias": "warn",

    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css", "**/*.less"] }],

    "garnet-tsx/one-export-per-component": "warn",
    "garnet-tsx/max-component-lines": "warn",
    "garnet-tsx/max-component-nesting": "warn"
  },
  "overrides": [
    {
      "files": [
        "**/Common/Components/ui/Dialog.tsx",
        "**/Common/Components/ui/Select.tsx",
        "**/Common/Components/ui/Tooltip.tsx",
        "**/Common/Components/Admin/AdminPanel/UserDetailContext.tsx",
        "**/Common/Components/UserPreviewModal/PreviewContext.tsx",
        "**/Common/Components/Admin/SystemSettings/SystemSettingsPage/Tabs/GeneralTabs.tsx"
      ],
      "rules": {
        "garnet-tsx/one-export-per-component": "off"
      }
    }
  ]
}
