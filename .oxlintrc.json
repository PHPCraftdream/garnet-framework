{
  "$schema": "./FrontBuilder/node_modules/oxlint/configuration_schema.json",
  "extends": ["./FrontBuilder/node_modules/@react-carburetor/core/dist/lint/recommended.oxlintrc.json"],
  "jsPlugins": ["./FrontBuilder/oxlint-plugins/garnet-tsx-rules.js", "./FrontBuilder/node_modules/@react-carburetor/core/dist/lint/index.mjs"],
  "plugins": ["react", "typescript", "unicorn", "import"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/*.gen.js",
    "**/*.gen.css",
    "**/I18nGen/**",
    "vendor/**"
  ],
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-underscore-dangle": "off",

    "react-hooks/exhaustive-deps": "warn",

    "unicorn/no-thenable": "off",

    "no-async-promise-executor": "warn",
    "no-shadow-restricted-names": "warn",
    "no-unused-expressions": "warn",
    "no-extra-boolean-cast": "warn",
    "no-cond-assign": "warn",
    "typescript/no-this-alias": "warn",

    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css", "**/*.less"] }],

    "garnet-tsx/one-export-per-component": "warn",
    "garnet-tsx/max-component-lines": "warn",
    "garnet-tsx/max-component-nesting": "warn"
  },
  "overrides": [
    {"files": ["**/AdminGrid/AdminGrid.tsx"], "rules": {"carburetor/require-function-class": "error"}},
    {
      "files": ["**/Common/Components/Admin/AdminLog/details/ActionLogDetail.tsx", "**/Common/Components/Admin/AdminLog/details/CronLogDetail.tsx", "**/Common/Components/Admin/AdminLog/details/ErrorLogDetail.tsx"],
      "rules": {"carburetor/require-function-class": "error", "carburetor/no-react-hooks-in-components": "error"}
    },
    {
      "files": ["**/Common/Components/Feedback/ConfirmModal.tsx", "**/Common/Components/Form/FormBuilder/PhotoField.tsx", "**/Common/Components/Form/FormBuilder/FormBuilderInput.tsx", "**/Common/Components/Form/FormBuilder/FormBuilderTextarea.tsx", "**/Common/Components/Form/FormBuilder/FormBuilderSelect.tsx"],
      "rules": {"carburetor/require-function-class": "error"}
    },
    {
      "files": ["**/Common/Components/Admin/SystemSettings/SystemSettingsPage/index.tsx"],
      "rules": {"carburetor/require-function-class": "error", "carburetor/no-react-hooks-in-components": "error"}
    },
    {
      "files": ["**/auth/Auth2.tsx"],
      "rules": {"carburetor/require-function-class": "error", "carburetor/no-react-hooks-in-components": "error"}
    },
    {
      "files": ["**/Common/Components/Controls/ThemeToggle.tsx", "**/Common/Components/Controls/AsyncIcon.tsx", "**/Common/Components/Controls/DurationSelect.tsx", "**/Common/Components/Controls/Calendar.tsx", "**/Common/Components/Controls/AsyncIconButton.tsx", "**/Common/Components/Controls/ImageUploadArea.tsx", "**/Common/Components/Controls/ImageUploadField.tsx", "**/Common/Components/Layout/Paging/*.tsx", "**/Common/Components/Feedback/Banner.tsx", "**/Common/Components/Feedback/TimezoneNotice.tsx", "**/auth/DevLogin.tsx", "**/auth/utils/CodeTimer.tsx", "**/auth/AuthConsentFields.tsx", "**/Common/Components/Feedback/GlobalToastRenderer.tsx", "**/Common/Components/Feedback/Toast.tsx", "**/Common/Components/Feedback/TimezoneNoticeWarnIsland.tsx", "**/Common/Components/Layout/Navigation/TabBreadcrumb.tsx", "**/Common/Components/Layout/Navigation/TabClose.tsx", "**/Common/Components/Layout/Navigation/TabNav.tsx", "**/Common/Components/Form/FormBuilder/FormRow.tsx", "**/Common/Components/Form/FormBuilder/PhotoField.tsx", "**/Common/Components/Form/FormBuilder/DatalistSelect.tsx", "**/Common/Components/Form/FormBuilder/FormBooleanField.tsx", "**/Common/Components/Form/FormBuilder/FormReadonlyValue.tsx", "**/Common/Components/Form/FormBuilder/FormBuilderError.tsx", "**/Common/Components/Layout/Navigation/NavigationCountBadge.tsx", "**/Common/Components/Layout/Navigation/NavigationUnreadDot.tsx", "**/Common/Components/Layout/Navigation/NavigationDivider.tsx", "**/Common/Components/Layout/Navigation/UtilityBalanceParts.tsx", "**/Common/Components/Admin/SystemSettings/SystemSettingsPage/VersionInfoPanel.tsx", "**/Common/Components/Admin/SystemSettings/SystemSettingsPage/Tabs/SaveButton.tsx", "**/Common/Components/Admin/SystemSettings/SystemSettingsPage/SettingsTabStrip.tsx", "**/Common/Components/Admin/SystemSettings/SystemSettingsPage/OpcacheResetView.tsx", "**/Common/Components/Admin/SystemSettings/SystemSettingsPage/Tabs/HistoryTab.tsx", "**/Common/Components/Admin/SystemSettings/SystemSettingsPage/Tabs/RegistrationTab.tsx", "**/Common/Components/Admin/SystemSettings/SystemSettingsPage/Tabs/PenaltyTab.tsx", "**/Common/Components/Admin/SystemSettings/SystemSettingsPage/Tabs/ContactsTab.tsx", "**/Common/Components/Admin/SystemSettings/SystemSettingsPage/Tabs/SmtpTab.tsx", "**/Common/Components/Admin/AdminGrid/AdminGridSearch.tsx", "**/Common/Components/Admin/AdminGrid/AdminGridHeader.tsx", "**/Common/Components/Admin/AdminGrid/AdminGridTableShell.tsx", "**/Common/Components/Admin/AdminGrid/AdminGridEmptyRow.tsx", "**/Common/Components/Admin/AdminGrid/AdminGridRow.tsx"],
