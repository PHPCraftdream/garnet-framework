{% extends 'layout.twig' %}

{% block content %}
<div class="cliaccess-page">
    <div class="cliaccess-card">
        <h1 class="cliaccess-denied-title">Access Denied</h1>
        <p class="cliaccess-message">This token has already been used or is invalid.</p>
        <p class="cliaccess-denied-hint">Run <code class="cliaccess-inline-command">php garnet admin</code> to generate a new token.</p>
    </div>
</div>
{% endblock %}
